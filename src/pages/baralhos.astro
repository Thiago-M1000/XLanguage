---
import AppLayout from '../layouts/AppLayout.astro';import ConfirmDelete from '../components/ConfirmDelete.astro';
import {rpc,mensagemErro,type Baralho} from '../lib/estudo';
let baralhos:Baralho[]=[],erro='';try{baralhos=await rpc(Astro.locals.supabase,'xl_baralhos_resumo',{p_idioma:Astro.locals.perfil.idioma_ativo})}catch(e){erro=mensagemErro(e)}
---
<AppLayout title="Baralhos" active="baralhos"><button slot="actions" type="button" data-open="deck-dialog" data-new-deck class="primary-button">Novo baralho</button>
 {erro&&<p class="xl-error" role="alert">{erro}</p>}
 <div class="xl-decks-grid">{baralhos.map(b=><article class="tool-card xl-live-deck"><div class="tool-card-heading"><div><h2>{b.nome}</h2><p>{b.descricao||'Seu vocabulário organizado por tema.'}</p></div><span class="status-badge" data-status={b.pendentes?'responded':'sold'}>{b.pendentes} pendentes</span></div><p class="xl-deck-count">{b.cartoes} <span>cartões</span></p><div class="xl-progress" role="progressbar" aria-label={`Progresso de ${b.nome}`} aria-valuemin="0" aria-valuemax="100" aria-valuenow={b.cartoes?Math.round(b.aprendidas/b.cartoes*100):0}><span style={`width:${b.cartoes?b.aprendidas/b.cartoes*100:0}%`}></span></div><p class="xl-help mt-3">{b.aprendidas} consolidadas · 2 acertos espaçados ou mais</p><div class="xl-inline-actions mt-5"><a href={`/revisao?baralho=${b.id}`} class="primary-button">Revisar</a><a href={`/dicionario?baralho=${b.id}`} class="secondary-button">Ver palavras</a><button type="button" class="edit-button" data-deck-edit={JSON.stringify(b)}>Editar</button><button type="button" class="edit-button xl-delete-text" data-delete-action="excluir-baralho" data-id={b.id} data-name={b.nome}>Excluir</button></div></article>)}</div>
 {!baralhos.length&&!erro&&<section class="tool-card xl-empty"><h2>Crie seu primeiro baralho</h2><p>Separe as palavras por temas, aulas ou situações do dia a dia.</p><button type="button" data-open="deck-dialog" data-new-deck class="primary-button mt-5">Criar baralho</button></section>}
 <dialog id="deck-dialog" class="xl-dialog" aria-labelledby="deck-title"><form id="deck-form" data-api="baralho" class="xl-modal-content xl-stack"><div class="settings-heading"><h2 id="deck-title">Novo baralho</h2><button type="button" class="settings-close" data-close aria-label="Fechar">×</button></div><input type="hidden" name="id" value=""/><input type="hidden" name="idioma" value={Astro.locals.perfil.idioma_ativo}/><div class="xl-field"><label for="deck-name">Nome do baralho</label><input id="deck-name" name="nome" required maxlength="100" placeholder="Ex.: Inglês para reuniões"/></div><div class="xl-field"><label for="deck-description">Descrição</label><textarea id="deck-description" name="descricao" rows="3" maxlength="500"></textarea></div><p class="xl-help">Depois de criar, selecione este baralho ao adicionar ou editar uma palavra no dicionário.</p><p data-feedback role="alert" class="xl-error empty:hidden"></p><div class="xl-form-actions"><button type="button" class="secondary-button" data-close>Cancelar</button><button type="submit" class="primary-button">Salvar baralho</button></div></form></dialog><ConfirmDelete/>
</AppLayout>
<script>
 import {iniciarUI} from '../scripts/ui';iniciarUI();const form=document.getElementById('deck-form') as HTMLFormElement;
 document.querySelectorAll('[data-new-deck]').forEach(b=>b.addEventListener('click',()=>{form.reset();(form.elements.namedItem('id') as HTMLInputElement).value='';document.getElementById('deck-title')!.textContent='Novo baralho';form.querySelector('[data-feedback]')!.textContent=''}));
 document.querySelectorAll<HTMLButtonElement>('[data-deck-edit]').forEach(b=>b.addEventListener('click',()=>{const data=JSON.parse(b.dataset.deckEdit!);for(const name of ['id','nome','descricao'])(form.elements.namedItem(name) as HTMLInputElement).value=data[name];document.getElementById('deck-title')!.textContent='Editar baralho';form.querySelector('[data-feedback]')!.textContent='';(document.getElementById('deck-dialog') as HTMLDialogElement).showModal()}));
</script>
