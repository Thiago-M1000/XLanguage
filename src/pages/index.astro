---
import AppLayout from '../layouts/AppLayout.astro';
import {rpc,mensagemErro,type Painel,type Baralho} from '../lib/estudo';import {idioma} from '../lib/idiomas';
const perfil=Astro.locals.perfil;let painel:Painel|null=null,baralhos:Baralho[]=[],erro='';
try{[painel,baralhos]=await Promise.all([rpc<Painel>(Astro.locals.supabase,'xl_painel',{p_idioma:perfil.idioma_ativo}),rpc<Baralho[]>(Astro.locals.supabase,'xl_baralhos_resumo',{p_idioma:perfil.idioma_ativo})])}catch(e){erro=mensagemErro(e)}
const pct=painel?Math.round(painel.hoje/perfil.meta_diaria*100):0;
const metrics=painel?[
 {label:'Cartões para revisar',value:String(painel.pendentes),description:'Vencidos e novos, prontos para estudar',primary:true,conversion:false,icon:'M4 7h13v14H4zM8 7V3h13v14h-4'},
 {label:'Palavras no dicionário',value:String(painel.total),description:`${painel.aprendidas} consolidadas`,primary:false,conversion:false,icon:'M4 19V5a2 2 0 0 1 2-2h14v14H6a2 2 0 0 0 0 4h14v-4'},
 {label:'Sequência de estudo',value:`${painel.sequencia} ${painel.sequencia===1?'dia':'dias'}`,description:'Dias consecutivos com revisões',primary:false,conversion:false,icon:'M13 3s1 5-2 7c0-3-2-4-2-4s-5 6-4 10a7 7 0 0 0 14-1c0-5-6-12-6-12Z'},
 {label:'Meta de hoje',value:`${pct}%`,description:`${painel.hoje} de ${perfil.meta_diaria} palavras revisadas`,primary:false,conversion:true,icon:'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z'},
]:[];
const max=painel?Math.max(perfil.meta_diaria,...painel.semana.map(d=>d.cartoes),1):1;
---
<AppLayout title="Início" active="inicio">
 {erro&&<p role="alert" class="xl-error">{erro}</p>}
 {painel&&<><div class="section-heading overview-heading"><h2 class="section-tab">Visão geral</h2><span class="period-note">{idioma(perfil.idioma_ativo).nome} · Seu progresso</span></div>
 <section class="metrics-grid" aria-label="Indicadores dos estudos">{metrics.map(m=><article class:list={['metric-card',{'metric-primary':m.primary,'metric-conversion':m.conversion}]}><div class="metric-heading"><h2>{m.label}</h2><span class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={m.icon}/></svg></span></div><p class="metric-value">{m.value}</p><p class="metric-description"><span class="metric-dot"></span>{m.description}</p>{m.primary&&<div class="metric-primary-bottom"><div><span class="metric-foot-label">Estudadas hoje</span><strong>{painel.hoje}</strong></div><a href="/revisao" class="metric-view-link">Começar revisão →</a></div>}</article>)}</section>
 <section id="daily-goal-card" class="tool-card daily-goal-card" aria-labelledby="goal-title"><header class="daily-goal-heading"><div class="daily-goal-heading-copy"><span class="daily-goal-heading-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/></svg></span><div><h2 id="goal-title">Sua meta diária</h2><p>Palavras diferentes revisadas hoje.</p></div></div><a class="xl-text-link" href="/configuracoes">Editar meta</a></header><div class="daily-goal-body"><div class="daily-goal-today"><div class="daily-goal-numbers"><p id="goal-progress-label"><strong>{painel.hoje}</strong><span>de {perfil.meta_diaria} palavras</span></p><span class="goal-percent">{pct}%</span></div><progress id="goal-progress" value={Math.min(painel.hoje,perfil.meta_diaria)} max={perfil.meta_diaria} aria-label="Meta diária de estudo"></progress><p class="goal-status">{painel.hoje>=perfil.meta_diaria?'Meta concluída. Bom estudo!':`Faltam ${perfil.meta_diaria-painel.hoje} palavras para a meta.`}</p><div class="goal-week-stats"><div><strong>{painel.aprendidas}</strong><span>Consolidadas após 2 acertos espaçados</span></div><div><strong>{painel.sequencia} dias</strong><span>De estudo consecutivo neste idioma</span></div></div></div><div class="goal-history"><div class="goal-history-heading"><h3>Últimos 7 dias</h3><span id="goal-history-reference">{perfil.timezone}</span></div><div class="goal-history-chart"><div class="goal-history-plot"><div class="goal-history-bars">{painel.semana.map((d,i)=><div class="goal-day" tabindex="0" role="img" data-today={i===6?'true':'false'} style={`--day-height:${Math.round(d.cartoes/max*100)}%`} aria-label={`${d.data}: ${d.cartoes} palavras revisadas`}><span class="goal-day-column"></span><span class="goal-day-count">{d.cartoes}</span><span class="goal-day-caption">{new Intl.DateTimeFormat('pt-BR',{weekday:'short',timeZone:'UTC'}).format(new Date(d.data+'T12:00:00Z'))}</span><span class="goal-day-tip">{d.data.split('-').reverse().join('/')} · {d.cartoes} palavras revisadas</span></div>)}</div></div></div></div></div></section>
 <section class="contacts-panel"><div class="contacts-heading"><div><h2>Seus baralhos</h2><p>Organizados por tema, prontos para revisar.</p></div><a href="/baralhos" class="secondary-button">Gerenciar</a></div>{baralhos.length?<ul class="leads-list">{baralhos.map(b=><li class="lead-row"><div class="lead-details"><h3 class="lead-name">{b.nome}</h3><p class="xl-help mt-1">{b.cartoes} cartões · {b.pendentes} para revisar</p></div><div class="lead-actions"><a class="edit-button" href={`/dicionario?baralho=${b.id}`}>Ver palavras</a><a class="advance-button" href={`/revisao?baralho=${b.id}`}>Revisar</a></div></li>)}</ul>:<div class="xl-empty"><p>Crie seu primeiro baralho para organizar as palavras.</p><a href="/baralhos" class="primary-button mt-5">Criar baralho</a></div>}</section>
 {painel.total===0&&<p class="xl-help mt-5">Comece pelo <a class="xl-text-link" href="/dicionario">dicionário</a>: adicione uma palavra ou importe sua lista.</p>}
 </>}
</AppLayout>
