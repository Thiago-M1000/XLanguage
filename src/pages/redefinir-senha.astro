---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Nova senha · XLanguage"><main class="xl-auth-center"><section class="tool-card xl-auth-card"><h1>Definir nova senha</h1><p class="xl-help mt-3">Use pelo menos 8 caracteres.</p>{Astro.url.searchParams.has('erro')&&<p class="xl-error mt-5" role="alert">Não foi possível atualizar. Confira se as senhas coincidem e se atendem às regras da sua conta.</p>}<form method="post" action="/api/redefinir-senha" class="xl-stack mt-6"><div class="xl-field"><label for="new-password">Nova senha</label><input id="new-password" name="senha" type="password" required minlength="8" maxlength="1024" autocomplete="new-password"/></div><div class="xl-field"><label for="confirm-password">Confirmar senha</label><input id="confirm-password" name="confirmar" type="password" required minlength="8" maxlength="1024" autocomplete="new-password"/></div><button type="submit" class="primary-button">Salvar nova senha</button></form><a href="/configuracoes" class="xl-auth-link">Voltar ao app</a></section></main></Layout>
