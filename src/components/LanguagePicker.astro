---
import {IDIOMAS, idioma} from '../lib/idiomas';

const perfil = Astro.locals.perfil;
const atual = idioma(perfil.idioma_ativo);
const disponiveis = IDIOMAS.filter(item => perfil.idiomas.includes(item.codigo));
---
<div class="company-control xl-language-control">
 <div class="company-picker">
  <button id="study-language-trigger" type="button" class="company-trigger"
   aria-expanded="false" aria-controls="study-language-menu" aria-label={`Idioma de estudo: ${atual.nome}`}>
   <span class="language-code" aria-hidden="true">{atual.curto}</span>
   <span class="language-name">{atual.nome}</span>
   <svg class="company-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
  </button>
  <div id="study-language-menu" class="company-menu" role="group" aria-labelledby="study-language-label" hidden>
   <p id="study-language-label">Idioma de estudo</p>
   <div class="language-options">
    {disponiveis.map(item => (
     <button type="button" data-study-language={item.codigo} aria-pressed={item.codigo === atual.codigo}>
      <span class="language-code" aria-hidden="true">{item.curto}</span>
      <span class="language-name">{item.nome}</span>
      {item.codigo === atual.codigo && <span class="language-current" aria-hidden="true">Ativo ✓</span>}
     </button>
    ))}
   </div>
   <p id="language-status" role="status"></p>
   <p id="language-feedback" role="alert"></p>
   <a class="language-manage" href="/configuracoes#idiomas">
    Gerenciar idiomas <span aria-hidden="true">→</span>
   </a>
  </div>
 </div>
</div>

<style>
 .language-code {
  display: inline-grid;
  place-items: center;
  flex: 0 0 32px;
  height: 28px;
  border-radius: 7px;
  background: var(--surface);
  color: var(--ink);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .03em;
 }

 .language-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
 }

 #study-language-menu {
  width: min(290px, calc(100vw - 32px));
  min-width: 0;
  max-height: min(420px, calc(100dvh - 96px));
  padding: 8px;
  overflow-y: auto;
  overscroll-behavior: contain;
  box-shadow: 0 12px 32px #0003;
 }

 #study-language-menu[hidden] {
  display: none;
 }

 #study-language-label {
  padding: 7px 8px 10px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
 }

 .language-options {
  display: grid;
  gap: 3px;
 }

 .language-options button {
  min-height: 46px;
  padding: 7px 8px;
  font-weight: 500;
 }

 .language-options button[aria-pressed="true"] .language-code {
  background: var(--panel);
  color: var(--blue-text);
 }

 .language-options button[aria-disabled="true"] {
  cursor: progress;
 }

 .language-current {
  margin-inline-start: auto;
  color: var(--blue-text);
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
 }

 .language-manage {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  min-height: 44px;
  margin-top: 7px;
  padding: 8px;
  border-top: 1px solid var(--border);
  color: var(--blue-text);
  font-size: 13px;
  font-weight: 600;
 }

 .language-manage:hover {
  background: var(--surface);
 }

 :is(.language-options button, .language-manage):focus-visible {
  outline: 2px solid var(--blue-text);
  outline-offset: -2px;
 }

 #language-status,
 #language-feedback {
  padding: 6px 8px;
  font-size: 12px;
 }

 #language-status {
  color: var(--muted);
 }

 #language-feedback {
  color: var(--red);
 }

 :is(#language-status, #language-feedback):empty {
  padding: 0;
 }
</style>

<script>
 import {enviar} from '../scripts/ui';

 const trigger = document.getElementById('study-language-trigger') as HTMLButtonElement;
 const menu = document.getElementById('study-language-menu')!;
 const options = Array.from(menu.querySelectorAll<HTMLButtonElement>('[data-study-language]'));
 const active = options.find(button => button.getAttribute('aria-pressed') === 'true');
 const feedback = document.getElementById('language-feedback')!;
 const status = document.getElementById('language-status')!;
 let saving = false;

 function setOpen(open: boolean, focus?: HTMLElement) {
  menu.hidden = !open;
  trigger.setAttribute('aria-expanded', String(open));
  if (open) focus?.focus();
 }

 trigger.addEventListener('click', () => setOpen(Boolean(menu.hidden), active ?? options[0]));
 trigger.addEventListener('keydown', event => {
  if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
  event.preventDefault();
  setOpen(true, event.key === 'ArrowDown' ? active ?? options[0] : options.at(-1));
 });

 menu.addEventListener('keydown', event => {
  if (event.key === 'Escape') {
   event.preventDefault();
   setOpen(false);
   trigger.focus();
   return;
  }

  const index = options.indexOf(document.activeElement as HTMLButtonElement);
  if (index < 0) return;
  const destinations: Partial<Record<string, number>> = {
   ArrowDown: (index + 1) % options.length,
   ArrowUp: (index - 1 + options.length) % options.length,
   Home: 0,
   End: options.length - 1,
  };
  const next = destinations[event.key];
  if (next === undefined) return;
  event.preventDefault();
  options[next]?.focus();
 });

 for (const type of ['click', 'focusin']) {
  document.addEventListener(type, event => {
   if (event.target instanceof Node && !trigger.parentElement?.contains(event.target)) setOpen(false);
  });
 }

 options.forEach(button => button.addEventListener('click', async () => {
  if (saving) return;
  if (button === active) {
   setOpen(false);
   trigger.focus();
   return;
  }

  saving = true;
  options.forEach(option => option.setAttribute('aria-disabled', 'true'));
  feedback.textContent = '';
  status.textContent = 'Alterando idioma…';

  try {
   await enviar('idioma', {idioma: button.dataset.studyLanguage});
   const url = new URL(location.href);
   for (const filter of ['baralho', 'pagina', 'q']) url.searchParams.delete(filter);
   location.assign(url.pathname + url.search);
  } catch (error) {
   feedback.textContent = (error as Error).message;
   status.textContent = '';
   saving = false;
   options.forEach(option => option.removeAttribute('aria-disabled'));
  }
 }));
</script>
